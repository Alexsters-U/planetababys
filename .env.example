# Plantilla publica. Completa los valores en un archivo de entorno privado.
APP_ENV=development
APP_PORT=3000
SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
API_PORT=4000
COOKIE_SECURE=false
POSTGRES_USER=planetababys
POSTGRES_DB=planetababys
# Usa hexadecimal sin caracteres reservados para URLs.
POSTGRES_PASSWORD=CAMBIA_POR_64_CARACTERES_HEXADECIMALES
REDIS_PASSWORD=CAMBIA_POR_64_CARACTERES_HEXADECIMALES
DATABASE_URL=postgresql://planetababys:CAMBIA_POR_64_CARACTERES_HEXADECIMALES@127.0.0.1:5432/planetababys?schema=public
REDIS_URL=redis://:CAMBIA_POR_64_CARACTERES_HEXADECIMALES@127.0.0.1:6379
JWT_SECRET=CAMBIA_POR_SECRETO_ALEATORIO_DE_64_CARACTERES
SESSION_SECRET=CAMBIA_POR_OTRO_SECRETO_ALEATORIO_DE_64_CARACTERES
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_CATALOG=false
PAYMENT_MODE=wompi
WOMPI_ENV=test
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_KEY=
WOMPI_EVENTS_KEY=
# quote: se confirma una tarifa por solicitud antes de pagar.
SHIPPING_MODE=quote
# SHIPPING_CENTS solo se usa en modo fixed; no representa envío gratuito en quote.
SHIPPING_CENTS=0
SHIPPING_CONFIGURED=false
# Lista de ciudades separadas por coma o * para todo Colombia.
SHIPPING_ALLOWED_CITIES=*
UPLOAD_DIR=./uploads
# Mismo valor en frontend, API y entorno de Caddy; nunca NEXT_PUBLIC_.
PROXY_SHARED_SECRET=CAMBIA_POR_OTRO_SECRETO_ALEATORIO_DE_64_CARACTERES
# Vacío = obligatorio en producción. En la demo pública ponlo en true después de comprobar /api/health/proxy.
PROXY_IP_REQUIRED=
# Segundos de caché del catálogo en Redis; 0 la desactiva.
CATALOG_CACHE_SECONDS=30
# Respaldos: llave de 64 hexadecimales guardada fuera del servidor, y cantidad de respaldos locales a conservar.
BACKUP_ENCRYPTION_KEY=
BACKUP_KEEP=14
# Activar solo en el dominio comercial definitivo.
INDEXING_ENABLED=false
STORE_LEGAL_NAME=
STORE_TAX_ID=
STORE_ADDRESS=
STORE_CONTACT_EMAIL=
STORE_CONTACT_PHONE=
